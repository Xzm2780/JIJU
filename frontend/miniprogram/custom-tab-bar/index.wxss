.tabbar {
  position: fixed;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 20;
  display: flex;
  min-height: 100rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(165, 104, 108, 0.14);
  border-radius: 30rpx;
  box-sizing: border-box;
  background: rgba(255, 252, 251, 0.97);
  box-shadow: 0 14rpx 44rpx rgba(74, 52, 54, 0.16);
}

.tab-item {
  display: flex;
  min-width: 0;
  margin: 0;
  padding: 8rpx 4rpx;
  border-radius: 22rpx;
  background: transparent;
  color: #927f80;
  line-height: 1.1;
  flex: 1 1 0;
  width: 0;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 5rpx;
}

.tab-icon {
  font-size: 34rpx;
  font-weight: 700;
}

.tab-text {
  font-size: 20rpx;
}

.tab-active {
  background: #f1e0e2;
  color: #7c4c52;
}

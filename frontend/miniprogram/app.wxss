page {
  min-height: 100%;
  background: linear-gradient(160deg, #fbf7f4 0%, #f5f0ee 48%, #eee3e2 100%);
  color: #30292a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.card {
  border-radius: 32rpx;
  padding: 32rpx;
  background: #fffcfb;
  box-shadow: 0 20rpx 60rpx rgba(74, 52, 54, 0.12);
}

.primary-button {
  border-radius: 20rpx;
  background: #a5686c;
  color: #fff;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(165, 104, 108, 0.22);
}

.secondary-button {
  border-radius: 20rpx;
  background: #fffdfc;
  color: #30292a;
  border: 1rpx solid #e0d4d2;
}

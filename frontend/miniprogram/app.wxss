page {
  min-height: 100%;
  background: linear-gradient(160deg, #fbf6ed 0%, #f7efe4 48%, #f2e4d3 100%);
  color: #382d27;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.card {
  border-radius: 32rpx;
  padding: 32rpx;
  background: #fffaf3;
  box-shadow: 0 20rpx 60rpx rgba(84, 56, 40, 0.12);
}

.primary-button {
  border-radius: 20rpx;
  background: #b85b43;
  color: #fff;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(184, 91, 67, 0.2);
}

.secondary-button {
  border-radius: 20rpx;
  background: #fffdf9;
  color: #382d27;
  border: 1rpx solid #e6d7c7;
}

<view class="page">
  <view class="header-row">
    <view>
      <text class="eyebrow">新帖子</text>
      <text class="title">此刻，想说点什么？</text>
    </view>
    <text class="counter {{charCount > 500 ? 'counter-error' : ''}}">{{charCount}} / 500</text>
  </view>

  <view wx:if="{{message}}" class="message {{messageType}}">{{message}}</view>

  <view class="card">
    <view class="field">
      <text class="label">正文</text>
      <textarea
        class="textarea"
        value="{{bodyText}}"
        maxlength="-1"
        placeholder="不用解释背景，只写下此刻的感受。"
        bindinput="onBodyInput"
      />
      <text class="help">1～500 个可见字符</text>
    </view>

    <view class="grid">
      <view class="field">
        <text class="label">情绪标签（可选）</text>
        <picker range="{{emotionTags}}" range-key="name" value="{{emotionIndex}}" bindchange="onEmotionChange">
          <view class="picker">{{emotionTags[emotionIndex] ? emotionTags[emotionIndex].name : '标签加载中'}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">情境标签（可选）</text>
        <picker range="{{contextTags}}" range-key="name" value="{{contextIndex}}" bindchange="onContextChange">
          <view class="picker">{{contextTags[contextIndex] ? contextTags[contextIndex].name : '标签加载中'}}</view>
        </picker>
      </view>
    </view>

    <view class="field">
      <text class="label">留存时长</text>
      <view class="segmented">
        <button class="segment {{retentionHours === 24 ? 'segment-active' : ''}}" data-hours="24" bindtap="onRetentionChange">24 小时</button>
        <button class="segment {{retentionHours === 72 ? 'segment-active' : ''}}" data-hours="72" bindtap="onRetentionChange">3 天</button>
        <button class="segment {{retentionHours === 168 ? 'segment-active' : ''}}" data-hours="168" bindtap="onRetentionChange">7 天</button>
      </view>
    </view>

    <view class="public-notice">
      <text class="notice-title">这是一条公开内容</text>
      <text class="notice-copy">帖子会进入公共广场，可能被其他用户查看或截图。不要填写可识别个人身份的信息。</text>
      <checkbox-group class="acknowledgement-group" bindchange="onPublicAcknowledgedChange">
        <label class="acknowledgement">
          <checkbox value="acknowledged" checked="{{publicAcknowledged}}" color="#a5686c" />
          <text>我已了解公开属性</text>
        </label>
      </checkbox-group>
    </view>

    <view class="footer">
      <button class="primary-button submit" loading="{{publishing}}" disabled="{{publishing || loadingTags}}" bindtap="onSubmit">
        发布到广场
      </button>
    </view>
  </view>

</view>

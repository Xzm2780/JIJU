.page {
  max-width: 760rpx;
  margin: 0 auto;
}

.header-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
  margin: 16rpx 8rpx 30rpx;
}

.eyebrow,
.title {
  display: block;
}

.eyebrow {
  margin-bottom: 8rpx;
  color: #a5686c;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.title {
  font-family: "Songti SC", serif;
  font-size: 48rpx;
  font-weight: 600;
}

.counter {
  margin-top: 16rpx;
  color: #766b6d;
  font-size: 24rpx;
}

.counter-error {
  color: #9f4b49;
}

.info-banner,
.message {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #f1e0e2;
  color: #7c4c52;
  font-size: 26rpx;
}

.message.error {
  background: #f6e3e1;
  color: #9f4b49;
}

.message.warning {
  background: #f7ebdc;
  color: #926435;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.textarea,
.picker {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid #e0d4d2;
  border-radius: 20rpx;
  background: #fffdfc;
}

.textarea {
  min-height: 280rpx;
  padding: 24rpx;
  line-height: 1.7;
}

.picker {
  min-height: 84rpx;
  padding: 24rpx;
}

.help {
  display: block;
  margin-top: 10rpx;
  color: #766b6d;
  font-size: 22rpx;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.segmented {
  display: flex;
  align-items: stretch;
  width: 100%;
  min-width: 0;
  gap: 8rpx;
}

.segment {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 16rpx 4rpx;
  overflow: hidden;
  border: 1rpx solid #e0d4d2;
  border-radius: 18rpx;
  background: #fffdfc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.segment-active {
  border-color: #a5686c;
  background: #f1e0e2;
  color: #7c4c52;
  font-weight: 700;
}

.public-notice {
  margin-top: 8rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #dfc7b9;
  border-radius: 18rpx;
  background: #fbf2ec;
}

.notice-title,
.notice-copy {
  display: block;
}

.notice-title {
  margin-bottom: 6rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.notice-copy {
  color: #685149;
  font-size: 22rpx;
  line-height: 1.5;
}

.acknowledgement-group {
  margin-top: 12rpx;
}

.acknowledgement {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  gap: 10rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid #dfc7b9;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  font-weight: 650;
}

.acknowledgement checkbox {
  transform: scale(0.86);
  transform-origin: center;
}

.footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-top: 30rpx;
}

.draft-tip {
  color: #766b6d;
  font-size: 22rpx;
}

.submit {
  flex: none;
  min-width: 240rpx;
  margin: 0;
}

.modal-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(50, 38, 40, 0.5);
}

.modal {
  width: 100%;
  padding: 34rpx;
  border-radius: 28rpx;
  background: #fffcfb;
  box-sizing: border-box;
}

.modal-title {
  display: block;
  margin-bottom: 16rpx;
  font-family: "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 650;
}

.modal-copy {
  color: #766b6d;
  font-size: 26rpx;
  line-height: 1.7;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.modal-actions button {
  flex: 1;
}

@media (max-width: 360px) {
  .segment {
    padding: 14rpx 2rpx;
    font-size: 20rpx;
  }
}

<view class="page login-page">
  <view class="login-hero card">
    <view class="brand-mark">J</view>
    <text class="title">欢迎来到 JIJU</text>

    <view wx:if="{{session}}" class="signed-in">
      <text class="signed-title">已登录</text>
      <text class="signed-name">{{session.user.plaza_nickname}}</text>
      <view wx:if="{{!session.noticeConfirmed}}" class="agreement">
        <checkbox-group bindchange="onAgreementChange">
          <label class="agreement-label">
            <checkbox value="agreed" checked="{{agreed}}" color="#a5686c" />
            <text>我已阅读并同意</text>
          </label>
        </checkbox-group>
        <text class="agreement-link" bindtap="openNotice">《使用须知》</text>
      </view>
      <button class="primary-button action" loading="{{busy}}" disabled="{{busy || (!session.noticeConfirmed && !agreed)}}" bindtap="continueSession">
        {{session.noticeConfirmed ? '返回继续' : '完成须知确认'}}
      </button>
    </view>

    <block wx:else>
      <view class="agreement">
        <checkbox-group bindchange="onAgreementChange">
          <label class="agreement-label">
            <checkbox value="agreed" checked="{{agreed}}" color="#a5686c" />
            <text>我已阅读并同意</text>
          </label>
        </checkbox-group>
        <text class="agreement-link" bindtap="openNotice">《使用须知》</text>
      </view>
      <button class="primary-button action" loading="{{busy}}" disabled="{{busy || !agreed}}" bindtap="login">
        {{busy ? '正在登录…' : '微信一键登录'}}
      </button>
      <button class="secondary-button cancel" disabled="{{busy}}" bindtap="cancel">暂不登录，返回浏览</button>
    </block>

    <view wx:if="{{error}}" class="login-error">{{error}}</view>
  </view>
</view>

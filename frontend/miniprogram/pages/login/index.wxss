.login-page {
  display: flex;
  min-height: 100vh;
  padding-top: 64rpx;
  align-items: flex-start;
  justify-content: center;
}

.login-hero {
  width: 100%;
  padding: 48rpx 36rpx 36rpx;
  box-sizing: border-box;
  text-align: center;
}

.brand-mark {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 26rpx;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #c38c90, #a5686c);
  box-shadow: 0 18rpx 42rpx rgba(165, 104, 108, 0.26);
  color: #fff;
  font-family: "Songti SC", serif;
  font-size: 54rpx;
  font-weight: 700;
  align-items: center;
  justify-content: center;
}

.eyebrow,
.title {
  display: block;
}

.title {
  color: #30292a;
  font-family: "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 650;
  line-height: 1.42;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.action,
.cancel {
  width: 100%;
  margin: 0;
}

.agreement {
  display: flex;
  margin: 34rpx 0 24rpx;
  color: #66595a;
  font-size: 23rpx;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.agreement-label {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.agreement checkbox {
  transform: scale(0.82);
}

.agreement-link {
  color: #8d565b;
  font-weight: 650;
}

.cancel {
  margin-top: 16rpx;
  font-size: 24rpx;
}

.signed-in {
  display: flex;
  margin: 30rpx 0;
  flex-direction: column;
  gap: 12rpx;
}

.signed-title {
  color: #708575;
  font-size: 22rpx;
  font-weight: 700;
}

.signed-name {
  color: #30292a;
  font-size: 30rpx;
  font-weight: 750;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.login-error {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f6e3e1;
  color: #914f4f;
  font-size: 24rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
  word-break: break-word;
}

<view class="page my-page">
  <view wx:if="{{!session}}" class="card guest-card">
    <view class="guest-avatar">我</view>
    <text class="guest-title">登录后管理你的情绪记录</text>
    <button class="primary-button" bindtap="openLogin">微信登录</button>
    <button class="secondary-button" bindtap="goPublish">先去写一条</button>
  </view>

  <block wx:else>
    <state-panel wx:if="{{loading && !profile}}" state="loading" title="正在加载广场身份" />
    <state-panel
      wx:elif="{{error && !profile}}"
      state="error"
      title="广场身份加载失败"
      message="{{error}}"
      action-text="重试"
      bind:action="retry"
    />

    <block wx:elif="{{profile}}">
      <view class="profile-card">
        <view class="avatar avatar-{{profile.avatar_color}}">{{avatarInitial}}</view>
        <view class="profile-main">
          <text class="profile-name">{{profile.plaza_nickname}}</text>
        </view>
        <button class="edit-link" size="mini" bindtap="editProfile">编辑</button>
      </view>

      <view class="dashboard card">
        <text class="section-title">我的内容</text>
        <view class="stats-grid">
          <view class="stat"><text class="stat-value">{{profile.stats.total}}</text><text class="stat-label">全部</text></view>
          <view class="stat"><text class="stat-value">{{profile.stats.active}}</text><text class="stat-label">有效</text></view>
          <view class="stat"><text class="stat-value">{{profile.stats.expired}}</text><text class="stat-label">已到期</text></view>
          <view class="stat"><text class="stat-value">{{profile.stats.hidden}}</text><text class="stat-label">已下架</text></view>
        </view>
      </view>

      <view class="menu-section">
        <text class="section-title">内容管理</text>
        <view class="menu-card">
          <view class="menu-item" hover-class="menu-item-hover" bindtap="openMyPosts">
            <text class="menu-icon">▤</text>
            <view class="menu-copy"><text class="menu-title">我的帖子</text></view>
            <text class="chevron">›</text>
          </view>
          <view class="menu-item" hover-class="menu-item-hover" bindtap="goPublish">
            <text class="menu-icon">＋</text>
            <view class="menu-copy"><text class="menu-title">发布新内容</text></view>
            <text class="chevron">›</text>
          </view>
        </view>
      </view>

      <view class="menu-section">
        <text class="section-title">账号与服务</text>
        <view class="menu-card">
          <view class="menu-item" hover-class="menu-item-hover" bindtap="editProfile">
            <text class="menu-icon">◎</text>
            <view class="menu-copy"><text class="menu-title">广场身份</text></view>
            <text class="chevron">›</text>
          </view>
          <view class="menu-item" hover-class="menu-item-hover" bindtap="openNotice">
            <text class="menu-icon">◇</text>
            <view class="menu-copy"><text class="menu-title">使用须知</text></view>
            <text class="chevron">›</text>
          </view>
          <view class="menu-item" hover-class="menu-item-hover" bindtap="openSettings">
            <text class="menu-icon">⚙</text>
            <view class="menu-copy"><text class="menu-title">账号设置</text></view>
            <text class="chevron">›</text>
          </view>
        </view>
      </view>
    </block>
  </block>
</view>

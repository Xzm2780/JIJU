.edit-card {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.header-row {
  display: flex;
  min-width: 0;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  min-width: 0;
  font-size: 38rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.counter {
  flex: 0 0 auto;
  color: #8f7e7f;
  font-size: 23rpx;
}

.counter-error {
  color: #914f4f;
}

.textarea {
  width: 100%;
  min-height: 360rpx;
  padding: 24rpx;
  border: 1rpx solid #e4d7d4;
  border-radius: 22rpx;
  box-sizing: border-box;
  background: #fffdfc;
  font-size: 30rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.grid {
  display: flex;
  gap: 16rpx;
}

.picker {
  display: block;
  min-height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e4d7d4;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #fffdfc;
  color: #5f5354;
  font-size: 26rpx;
  line-height: 80rpx;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid picker {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
}

.fixed-expiry {
  max-width: 100%;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f8f1ed;
  color: #876d58;
  font-size: 23rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.profile-form {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.login-required {
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 20rpx;
  text-align: center;
}

.login-title {
  color: #30292a;
  font-size: 32rpx;
  font-weight: 750;
}

.avatar-preview {
  display: flex;
  width: 140rpx;
  height: 140rpx;
  margin: 8rpx auto;
  border-radius: 50%;
  background: linear-gradient(145deg, #c28e91, #a5686c);
  color: #fff;
  font-size: 52rpx;
  font-weight: 800;
  align-items: center;
  justify-content: center;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.label-row {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.label {
  color: #5f5354;
  font-size: 24rpx;
  font-weight: 700;
}

.counter {
  flex: 0 0 auto;
  color: #a18d8e;
  font-size: 20rpx;
}

.input {
  width: 100%;
  padding: 22rpx;
  border: 1rpx solid #e4d7d4;
  border-radius: 20rpx;
  box-sizing: border-box;
  background: #fffdfc;
  font-size: 27rpx;
  overflow-wrap: anywhere;
  word-break: break-word;
}

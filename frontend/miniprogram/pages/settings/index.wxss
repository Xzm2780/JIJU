.settings-group {
  margin-bottom: 28rpx;
}

.group-title {
  display: block;
  margin: 0 8rpx 12rpx;
  color: #8f7b7c;
  font-size: 22rpx;
  font-weight: 700;
}

.settings-list {
  width: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.setting-row {
  display: flex;
  width: 100%;
  min-height: 94rpx;
  margin: 0;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0e5e2;
  border-radius: 0;
  box-sizing: border-box;
  background: transparent;
  color: #30292a;
  font-size: 26rpx;
  text-align: left;
  align-items: center;
  justify-content: flex-start;
  line-height: 1.5;
  gap: 24rpx;
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-value {
  display: block;
  min-width: 0;
  max-width: 62%;
  overflow: hidden;
  color: #8d7a7b;
  font-size: 23rpx;
  margin-left: auto;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.setting-label {
  display: block;
  min-width: 0;
  flex: 1 1 0;
  text-align: left;
}

.setting-action {
  cursor: pointer;
}

.setting-action-hover {
  background: #faf3f0;
}

.setting-disabled {
  pointer-events: none;
  opacity: 0.56;
}

.setting-value.active {
  color: #6f8a73;
}

.chevron {
  flex: 0 0 auto;
  color: #b39b9d;
  font-size: 34rpx;
}

.danger-zone .group-title,
.danger-title {
  color: #914f4f;
}

.empty-card {
  display: flex;
  padding: 60rpx;
  color: #8d7a7b;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 20rpx;
  text-align: center;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.empty-title {
  color: #30292a;
  font-size: 30rpx;
  font-weight: 750;
}

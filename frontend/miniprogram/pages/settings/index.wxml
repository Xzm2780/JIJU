<view class="page">
  <view wx:if="{{!session}}" class="card empty-card">
    <text class="empty-title">登录后才能使用账号设置</text>
    <text class="empty-copy">登录状态仅用于当前账号，不会展示微信头像或昵称。</text>
    <button class="primary-button" bindtap="openLogin">微信登录</button>
  </view>
  <block wx:else>
    <view class="settings-group">
      <text class="group-title">账号</text>
      <view class="card settings-list">
        <view class="setting-row">
          <text>当前昵称</text>
          <text class="setting-value">{{session.user.plaza_nickname}}</text>
        </view>
        <view class="setting-row">
          <text>登录状态</text>
          <text class="setting-value active">已登录</text>
        </view>
      </view>
    </view>

    <view class="settings-group">
      <text class="group-title">会话</text>
      <view class="card settings-list">
        <button class="setting-row setting-button" loading="{{busy}}" disabled="{{busy}}" bindtap="logout">
          <text>退出当前会话</text>
          <text class="chevron">›</text>
        </button>
      </view>
    </view>

    <view class="settings-group danger-zone">
      <text class="group-title">危险操作</text>
      <view class="card settings-list">
        <button class="setting-row setting-button danger" disabled="{{busy}}" bindtap="deleteAccount">
          <view class="danger-copy">
            <text>永久注销账号</text>
            <text class="danger-desc">立即停用并进入 30 天冷静期</text>
          </view>
          <text class="chevron">›</text>
        </button>
      </view>
    </view>

    <view wx:if="{{message}}" class="message error">{{message}}</view>
  </block>
</view>

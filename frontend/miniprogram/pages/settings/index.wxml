<view class="page">
  <view wx:if="{{!session}}" class="card empty-card">
    <text class="empty-title">登录后才能使用账号设置</text>
    <button class="primary-button" bindtap="openLogin">微信登录</button>
  </view>
  <block wx:else>
    <view class="settings-group">
      <text class="group-title">账号</text>
      <view class="card settings-list">
        <view class="setting-row">
          <text class="setting-label">当前昵称</text>
          <text class="setting-value">{{session.user.plaza_nickname}}</text>
        </view>
        <view class="setting-row">
          <text class="setting-label">登录状态</text>
          <text class="setting-value active">已登录</text>
        </view>
      </view>
    </view>

    <view class="settings-group">
      <text class="group-title">服务与协议</text>
      <view class="card settings-list">
        <view class="setting-row setting-action" hover-class="setting-action-hover" aria-role="button" bindtap="openNotice">
          <text class="setting-label">使用须知</text>
          <text class="setting-value {{session.noticeConfirmed ? 'active' : ''}}">{{session.noticeConfirmed ? '已确认' : '待确认'}}</text>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>

    <view class="settings-group">
      <text class="group-title">会话</text>
      <view class="card settings-list">
        <view class="setting-row setting-action {{busy ? 'setting-disabled' : ''}}" hover-class="setting-action-hover" aria-role="button" bindtap="logout">
          <text class="setting-label">退出登录</text>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>

    <view class="settings-group danger-zone">
      <text class="group-title">危险操作</text>
      <view class="card settings-list">
        <view class="setting-row setting-action {{busy ? 'setting-disabled' : ''}}" hover-class="setting-action-hover" aria-role="button" bindtap="deleteAccount">
          <text class="setting-label danger-title">永久注销账号</text>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>

    <view wx:if="{{message}}" class="message error">{{message}}</view>
  </block>
</view>

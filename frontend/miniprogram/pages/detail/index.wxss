.detail-page {
  padding-top: 40rpx;
}

.detail-card {
  padding: 36rpx;
}

.meta-row,
.stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.author-line {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 14rpx;
}

.author-avatar {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #c38c90, #a5686c);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
}

.author-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.nickname {
  color: #7c4c52;
  font-size: 28rpx;
  font-weight: 700;
}

.author-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f1e0e2;
  color: #7c4c52;
  font-size: 20rpx;
}

.published {
  display: block;
  color: #9c898a;
  font-size: 22rpx;
}

.body {
  display: block;
  margin: 38rpx 0;
  color: #30292a;
  font-size: 34rpx;
  line-height: 1.85;
  white-space: pre-wrap;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f1e0e2;
  color: #7c4c52;
  font-size: 23rpx;
}

.tag-context {
  background: #efe9df;
  color: #796653;
}

.stats {
  padding: 24rpx 0;
  border-top: 1rpx solid #eee2e0;
  color: #776768;
  font-size: 23rpx;
  flex-wrap: wrap;
}

.expiry {
  display: flex;
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f7f0ec;
  color: #8a6c56;
  font-size: 22rpx;
  line-height: 1.7;
  flex-direction: column;
  gap: 6rpx;
}

.author-actions {
  display: flex;
  margin-top: 28rpx;
  gap: 16rpx;
}

.reaction-stage {
  position: relative;
  margin-top: 30rpx;
}

.reactions {
  display: flex;
  gap: 12rpx;
}

.reaction-button {
  display: flex;
  min-width: 0;
  min-height: 122rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 1rpx solid #e5d6d4;
  border-radius: 20rpx;
  background: #fffdfc;
  color: #6e5e5f;
  font-size: 21rpx;
  line-height: 1.3;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4rpx;
}

.reaction-icon {
  color: #9b6166;
  font-size: 36rpx;
  line-height: 1;
}

.reaction-label {
  font-size: 22rpx;
  font-weight: 700;
}

.reaction-number {
  color: #9a8586;
  font-size: 20rpx;
}

.reaction-active {
  border-color: #b87b7f;
  background: #f1e0e2;
  color: #7c4c52;
  font-weight: 700;
}

.reaction-active .reaction-icon,
.reaction-active .reaction-number {
  color: #7c4c52;
}

.reaction-burst {
  position: absolute;
  inset: -30rpx 0 auto;
  height: 150rpx;
  pointer-events: none;
}

.particle {
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  color: #a5686c;
  font-size: 32rpx;
  opacity: 0;
  animation: reaction-pop 0.7s ease-out forwards;
}

.particle-1 { --x: -130rpx; --y: -88rpx; animation-delay: 0s; }
.particle-2 { --x: -76rpx; --y: -118rpx; animation-delay: 0.03s; }
.particle-3 { --x: -24rpx; --y: -92rpx; animation-delay: 0.06s; }
.particle-4 { --x: 34rpx; --y: -112rpx; animation-delay: 0.09s; }
.particle-5 { --x: 86rpx; --y: -82rpx; animation-delay: 0.12s; }
.particle-6 { --x: 132rpx; --y: -58rpx; animation-delay: 0.15s; }

.burst-HEAD_PAT .particle {
  color: #9b7aa5;
}

.burst-CHEER .particle {
  color: #b78255;
}

@keyframes reaction-pop {
  0% {
    opacity: 0;
    transform: translate(0, 0) scale(0.5) rotate(0deg);
  }
  25% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translate(var(--x), var(--y)) scale(1.25) rotate(18deg);
  }
}

.reaction-message {
  display: block;
  margin-top: 14rpx;
  color: #914f4f;
  font-size: 22rpx;
}

.report-link {
  display: block;
  margin: 30rpx auto 0;
  background: transparent;
  color: #9a7778;
  font-size: 22rpx;
}

.comments {
  margin-top: 38rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #eee2e0;
}

.comments-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.comment-form {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8f1ed;
}

.comment-input {
  width: 100%;
  min-height: 130rpx;
  box-sizing: border-box;
  color: #30292a;
  font-size: 27rpx;
  line-height: 1.65;
}

.comment-submit-row,
.comment-head,
.comment-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-submit-row {
  margin-top: 14rpx;
  gap: 18rpx;
}

.comment-counter,
.comment-time,
.comment-loading {
  color: #9a8586;
  font-size: 21rpx;
}

.comment-submit {
  width: 190rpx;
  min-width: 190rpx;
  height: 70rpx;
  margin: 0;
  padding: 0 18rpx;
  font-size: 23rpx;
  line-height: 70rpx;
}

.comment-message,
.comment-empty,
.comment-loading {
  padding: 18rpx 0;
  font-size: 23rpx;
  text-align: center;
}

.comment-message {
  color: #914f4f;
}

.comment-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0e6e3;
}

.comment-author {
  color: #7c4c52;
  font-size: 24rpx;
  font-weight: 700;
}

.comment-body {
  display: block;
  margin: 12rpx 0;
  color: #4f4546;
  font-size: 27rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.comment-actions {
  justify-content: flex-end;
  gap: 20rpx;
}

.text-link {
  display: inline;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #8a7274;
  font-size: 21rpx;
}

.danger-text {
  color: #914f4f;
}

.author-actions button {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  margin: 0;
}

.danger-button {
  border-radius: 20rpx;
  background: #f6e7e4;
  color: #914f4f;
  font-weight: 700;
}

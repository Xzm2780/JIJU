.detail-page {
  padding-top: 40rpx;
}

.detail-card {
  padding: 36rpx;
}

.meta-row,
.stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.nickname {
  color: #7c4c52;
  font-size: 28rpx;
  font-weight: 700;
}

.author-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f1e0e2;
  color: #7c4c52;
  font-size: 20rpx;
}

.published {
  display: block;
  margin-top: 8rpx;
  color: #9c898a;
  font-size: 22rpx;
}

.body {
  display: block;
  margin: 38rpx 0;
  color: #30292a;
  font-size: 34rpx;
  line-height: 1.85;
  white-space: pre-wrap;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f1e0e2;
  color: #7c4c52;
  font-size: 23rpx;
}

.tag-context {
  background: #efe9df;
  color: #796653;
}

.stats {
  padding: 24rpx 0;
  border-top: 1rpx solid #eee2e0;
  color: #776768;
  font-size: 23rpx;
  flex-wrap: wrap;
}

.expiry {
  display: flex;
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f7f0ec;
  color: #8a6c56;
  font-size: 22rpx;
  line-height: 1.7;
  flex-direction: column;
  gap: 6rpx;
}

.detail-page {
  padding-top: 40rpx;
}

.detail-card {
  padding: 36rpx;
}

.meta-row,
.stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.nickname {
  color: #7c4c52;
  font-size: 28rpx;
  font-weight: 700;
}

.author-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f1e0e2;
  color: #7c4c52;
  font-size: 20rpx;
}

.published {
  display: block;
  margin-top: 8rpx;
  color: #9c898a;
  font-size: 22rpx;
}

.body {
  display: block;
  margin: 38rpx 0;
  color: #30292a;
  font-size: 34rpx;
  line-height: 1.85;
  white-space: pre-wrap;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f1e0e2;
  color: #7c4c52;
  font-size: 23rpx;
}

.tag-context {
  background: #efe9df;
  color: #796653;
}

.stats {
  padding: 24rpx 0;
  border-top: 1rpx solid #eee2e0;
  color: #776768;
  font-size: 23rpx;
  flex-wrap: wrap;
}

.expiry {
  display: flex;
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f7f0ec;
  color: #8a6c56;
  font-size: 22rpx;
  line-height: 1.7;
  flex-direction: column;
  gap: 6rpx;
}

.author-actions {
  display: flex;
  margin-top: 28rpx;
  gap: 16rpx;
}

.reactions {
  display: flex;
  margin-top: 28rpx;
  gap: 12rpx;
}

.reaction-button {
  display: flex;
  min-width: 0;
  min-height: 78rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 1rpx solid #e5d6d4;
  border-radius: 20rpx;
  background: #fffdfc;
  color: #6e5e5f;
  font-size: 23rpx;
  line-height: 1.3;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4rpx;
}

.reaction-active {
  border-color: #b87b7f;
  background: #f1e0e2;
  color: #7c4c52;
  font-weight: 700;
}

.reaction-message {
  display: block;
  margin-top: 14rpx;
  color: #914f4f;
  font-size: 22rpx;
}

.report-link {
  display: block;
  margin: 30rpx auto 0;
  background: transparent;
  color: #9a7778;
  font-size: 22rpx;
}

.author-actions button {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  margin: 0;
}

.danger-button {
  border-radius: 20rpx;
  background: #f6e7e4;
  color: #914f4f;
  font-weight: 700;
}

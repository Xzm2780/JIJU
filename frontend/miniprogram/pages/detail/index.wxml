<view class="page detail-page">
  <state-panel
    wx:if="{{loading}}"
    state="loading"
    title="正在打开这条内容"
  />

  <state-panel
    wx:elif="{{unavailable}}"
    state="unavailable"
    title="内容已不可用"
    message="这条内容可能已经到期、被隐藏或不存在。"
    action-text="返回广场"
    bind:action="backToFeed"
  />

  <state-panel
    wx:elif="{{error}}"
    state="error"
    title="暂时无法读取"
    message="{{error}}"
    action-text="重试"
    bind:action="retry"
  />

  <view wx:elif="{{post}}" class="detail-card card">
    <view class="meta-row">
      <view class="author-line">
        <view class="author-avatar">{{authorInitial}}</view>
        <view class="author-copy">
          <text class="nickname">{{post.author_nickname}}</text>
          <text class="published">{{publishedAt}}</text>
        </view>
      </view>
      <text wx:if="{{post.is_author}}" class="author-badge">作者视图</text>
    </view>

    <text class="body">{{post.body_text}}</text>

    <view wx:if="{{post.emotion_tag || post.context_tag}}" class="tags">
      <text wx:if="{{post.emotion_tag}}" class="tag">{{post.emotion_tag.name}}</text>
      <text wx:if="{{post.context_tag}}" class="tag tag-context">{{post.context_tag.name}}</text>
    </view>

    <view class="stats">
      <text>{{post.comment_count}} 条回应</text>
      <text>{{post.reaction_counts.total}} 个轻互动</text>
      <text wx:if="{{post.is_author}}">{{post.view_count}} 次浏览</text>
    </view>

    <view wx:if="{{post.is_author && expiresAt}}" class="expiry">
      <text>公开至 {{expiresAt}}</text>
      <text>到期后不再接受新的回应</text>
    </view>

    <view class="reaction-stage">
      <view wx:if="{{reactionEffect}}" class="reaction-burst burst-{{reactionEffect}}">
        <text class="particle particle-1">{{reactionEffectIcon}}</text>
        <text class="particle particle-2">{{reactionEffectIcon}}</text>
        <text class="particle particle-3">{{reactionEffectIcon}}</text>
        <text class="particle particle-4">{{reactionEffectIcon}}</text>
        <text class="particle particle-5">{{reactionEffectIcon}}</text>
        <text class="particle particle-6">{{reactionEffectIcon}}</text>
      </view>
      <view class="reactions" aria-label="轻互动">
        <button
          class="reaction-button {{myReaction === 'HUG' ? 'reaction-active' : ''}}"
          data-type="HUG"
          disabled="{{reactionBusy}}"
          bindtap="toggleReaction"
        >
          <text class="reaction-icon">♡</text>
          <text class="reaction-label">抱一抱</text>
          <text class="reaction-number">{{post.reaction_counts.hug}}</text>
        </button>
        <button
          class="reaction-button {{myReaction === 'HEAD_PAT' ? 'reaction-active' : ''}}"
          data-type="HEAD_PAT"
          disabled="{{reactionBusy}}"
          bindtap="toggleReaction"
        >
          <text class="reaction-icon">✧</text>
          <text class="reaction-label">摸摸头</text>
          <text class="reaction-number">{{post.reaction_counts.head_pat}}</text>
        </button>
        <button
          class="reaction-button {{myReaction === 'CHEER' ? 'reaction-active' : ''}}"
          data-type="CHEER"
          disabled="{{reactionBusy}}"
          bindtap="toggleReaction"
        >
          <text class="reaction-icon">✹</text>
          <text class="reaction-label">握拳</text>
          <text class="reaction-number">{{post.reaction_counts.cheer}}</text>
        </button>
      </view>
    </view>
    <text wx:if="{{reactionMessage}}" class="reaction-message">{{reactionMessage}}</text>

    <view class="comments">
      <text class="comments-title">回应（{{post.comment_count}}）</text>
      <view class="comment-form">
        <textarea
          class="comment-input"
          value="{{commentText}}"
          maxlength="-1"
          placeholder="写下一点回应，最多 200 个可见字符"
          bindinput="onCommentInput"
        />
        <view class="comment-submit-row">
          <text class="comment-counter">{{commentCount}} / 200</text>
          <button
            class="primary-button comment-submit"
            loading="{{commentSubmitting}}"
            disabled="{{commentSubmitting || commentCount === 0 || commentCount > 200}}"
            bindtap="submitComment"
          >
            发送回应
          </button>
        </view>
      </view>

      <view wx:if="{{commentMessage}}" class="comment-message">{{commentMessage}}</view>
      <view wx:if="{{!comments.length && !commentsLoading}}" class="comment-empty">还没有回应，留下一点温柔。</view>

      <view wx:for="{{comments}}" wx:key="id" class="comment-item">
        <view class="comment-head">
          <text class="comment-author">{{item.author_nickname}}</text>
          <text class="comment-time">{{item.publishedLabel}}</text>
        </view>
        <text class="comment-body">{{item.body_text}}</text>
        <view class="comment-actions">
          <button wx:if="{{!item.can_delete}}" class="text-link" data-id="{{item.id}}" bindtap="reportComment">举报</button>
          <button wx:if="{{item.can_delete}}" class="text-link danger-text" data-id="{{item.id}}" bindtap="removeComment">删除</button>
        </view>
      </view>
      <view wx:if="{{commentsLoading}}" class="comment-loading">正在加载回应…</view>
      <view wx:elif="{{!commentsHasMore && comments.length}}" class="comment-loading">已经看到全部回应</view>
    </view>

    <view wx:if="{{post.is_author}}" class="author-actions">
      <button class="secondary-button" bindtap="editPost">编辑</button>
      <button class="danger-button" bindtap="removePost">删除</button>
    </view>
    <button wx:else class="report-link" bindtap="reportPost">举报这条内容</button>
  </view>
</view>

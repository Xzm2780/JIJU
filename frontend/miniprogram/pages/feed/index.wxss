.feed-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.feed-header {
  display: flex;
  margin-bottom: 26rpx;
  align-items: center;
  justify-content: space-between;
}

.eyebrow,
.title {
  display: block;
}

.eyebrow {
  margin-bottom: 8rpx;
  color: #8f7376;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.title {
  color: #30292a;
  font-size: 48rpx;
  font-weight: 800;
}

.publish-entry {
  margin: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #a5686c;
  color: #fff;
  font-weight: 700;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.feed-card {
  width: 100%;
  margin: 0;
  padding: 30rpx;
  border: 1rpx solid rgba(165, 104, 108, 0.12);
  border-radius: 30rpx;
  background: #fffcfb;
  box-shadow: 0 16rpx 44rpx rgba(74, 52, 54, 0.09);
  box-sizing: border-box;
  color: #30292a;
  line-height: 1.5;
  text-align: left;
}

.card-title-row,
.counts {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nickname {
  color: #7c4c52;
  font-size: 26rpx;
  font-weight: 700;
}

.time {
  color: #9c898a;
  font-size: 21rpx;
}

.body {
  display: block;
  margin: 22rpx 0;
  font-size: 31rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.tag {
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #f1e0e2;
  color: #7c4c52;
  font-size: 22rpx;
}

.tag-context {
  background: #efe9df;
  color: #796653;
}

.counts {
  color: #877778;
  font-size: 22rpx;
}

.feed-status {
  padding: 20rpx;
  color: #8f7e7f;
  font-size: 24rpx;
  text-align: center;
}

.feed-status-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.text-button {
  display: inline;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #7c4c52;
  font-size: 24rpx;
}

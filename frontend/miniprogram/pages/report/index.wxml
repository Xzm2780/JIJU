<view class="page">
  <view class="card report-card">
    <block wx:if="{{!receipt}}">
      <text class="report-title">举报内容</text>
      <text class="report-copy">举报说明只供授权治理人员查看，不会展示给其他用户。</text>

      <view class="field">
        <text class="label">举报原因</text>
        <picker range="{{reasons}}" value="{{reasonIndex}}" bindchange="onReasonChange">
          <view class="picker">{{reasons[reasonIndex]}}</view>
        </picker>
      </view>

      <view wx:if="{{reasonIndex === 5}}" class="field">
        <text class="label">补充说明</text>
        <textarea
          class="textarea"
          value="{{otherDescription}}"
          maxlength="500"
          placeholder="请说明需要人工核查的具体问题"
          bindinput="onOtherInput"
        />
      </view>

      <view wx:if="{{message}}" class="message error">{{message}}</view>
      <button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交举报</button>
    </block>

    <view wx:else class="receipt">
      <text class="receipt-title">举报已提交</text>
      <text class="receipt-copy">平台会按治理流程核查。处理细节不会公开。</text>
      <text class="receipt-id">回执：{{receipt.report_id}}</text>
      <button class="primary-button" bindtap="back">返回</button>
    </view>
  </view>
</view>

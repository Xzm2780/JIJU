{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings"],
    "lib": ["ES2020", "ES2022.Intl", "DOM"],
    "outDir": "dist"
  },
  "include": ["miniprogram/**/*.ts", "miniprogram/**/*.d.ts", "tests/**/*.ts"]
}

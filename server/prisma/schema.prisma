generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TagCategory {
  EMOTION
  CONTEXT
}

enum PublicStatus {
  PUBLISHED
  HIDDEN
  EXPIRED
  DELETED
}

enum ModerationStatus {
  PASSED
  PENDING
  REJECTED
}

enum QuotaType {
  POST_DAILY
  COMMENT_ROLLING_60M
}

enum IdempotencyStatus {
  PROCESSING
  SUCCEEDED
}

enum ModerationPriority {
  PREEMPTIVE
  NORMAL
}

enum AdminRole {
  REPORT_REVIEWER
  CONTENT_MODERATOR
  ACCOUNT_MODERATOR
  AUDITOR
  CONFIG_ADMIN
}

enum ReportTargetType {
  POST
  COMMENT
}

enum ReportReason {
  ABUSE
  PRIVACY
  MINOR_INVOLVED
  DANGEROUS_OR_INAPPROPRIATE
  SPAM
  OTHER
}

enum ReportStatus {
  PENDING
  PROCESSING
  RESOLVED
}

enum ReactionType {
  HUG
  HEAD_PAT
  CHEER
}

model User {
  id                 String                @id
  loginCode          String?               @unique
  authSubjectRef     String?               @unique
  authProvider       String                @default("MOCK")
  plazaNickname      String
  avatarColor        String                @default("ROSE")
  accountStatus      String                @default("ACTIVE")
  postingRestrictedUntil    DateTime?
  commentingRestrictedUntil DateTime?
  reactionRestrictedUntil   DateTime?
  deactivatedAt      DateTime?
  accountDeletionScheduledAt DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  sessions           AuthSession[]
  notices            NoticeConfirmation[]
  posts              Post[]
  quotaUsages        QuotaUsage[]
  idempotencyRecords IdempotencyRecord[]
  moderationRecords  ModerationRecord[]
  comments           Comment[]
  reactions          Reaction[]
  viewRecords        ViewRecord[]
  reports            Report[]              @relation("ReportReporter")
  handledReports     Report[]              @relation("ReportHandler")
  adminRoles         AdminRoleAssignment[]
  adminCredential    AdminCredential?
  auditLogs          AuditLog[]

  @@index([accountDeletionScheduledAt])
}

model AdminCredential {
  id           String   @id
  userId       String   @unique
  username     String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username, active])
}

model AdminRoleAssignment {
  id        String    @id
  userId    String
  role      AdminRole
  scope     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active, role])
  @@index([role, active])
}

model AuthSession {
  id        String    @id
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model NoticeConfirmation {
  id            String   @id
  userId        String
  noticeVersion String
  confirmedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeVersion])
  @@index([userId, noticeVersion])
}

model TagCatalog {
  id        String   @id @default("current")
  version   String   @unique
  updatedAt DateTime @updatedAt
}

model Tag {
  id             String      @id
  category       TagCategory
  name           String
  sortOrder      Int         @default(0)
  enabled        Boolean     @default(true)
  isOther        Boolean     @default(false)
  catalogVersion String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([category, name])
  @@index([category, enabled, sortOrder])
}

model Post {
  id                     String           @id
  authorId               String
  bodyText               String
  bodyGraphemeLength     Int
  emotionTagId           String?
  emotionTagNameSnapshot String?
  contextTagId           String?
  contextTagNameSnapshot String?
  retentionHours         Int
  publicStatus           PublicStatus     @default(PUBLISHED)
  moderationStatus       ModerationStatus @default(PASSED)
  riskConfirmedAt        DateTime?
  publishedAt            DateTime
  expiresAt              DateTime
  currentContentVersion  Int              @default(1)
  editedAt               DateTime?
  hiddenAt               DateTime?
  deletedAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  author                 User             @relation(fields: [authorId], references: [id])
  versions               PostVersion[]
  comments               Comment[]
  reactions              Reaction[]
  viewRecords            ViewRecord[]

  @@index([publicStatus, moderationStatus, publishedAt, id])
  @@index([publicStatus, expiresAt, publishedAt, id])
  @@index([authorId, publicStatus, publishedAt, id])
  @@index([expiresAt, publicStatus])
}

model PostVersion {
  id                     String   @id
  postId                 String
  versionNumber          Int
  bodyText               String
  bodyGraphemeLength     Int
  emotionTagId           String?
  emotionTagNameSnapshot String?
  contextTagId           String?
  contextTagNameSnapshot String?
  createdAt              DateTime @default(now())
  post                   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, versionNumber])
}

model Comment {
  id                     String           @id
  postId                 String
  authorId               String
  bodyText               String
  bodyGraphemeLength     Int
  contentVersion         Int              @default(1)
  moderationStatus       ModerationStatus @default(PASSED)
  publishedAt            DateTime         @default(now())
  deletedAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  post                   Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  author                 User             @relation(fields: [authorId], references: [id])

  @@index([postId, publishedAt, id])
  @@index([authorId, publishedAt, id])
}

model Reaction {
  id        String       @id
  userId    String
  postId    String
  type      ReactionType
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id])
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId, type, active])
}

model ViewRecord {
  id        String   @id
  postId    String
  viewerId  String?
  viewToken String
  viewedAt  DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewer    User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@unique([postId, viewToken])
  @@index([postId, viewedAt])
}

model QuotaUsage {
  id         String    @id
  userId     String
  quotaType  QuotaType
  requestId  String
  sourceId   String
  consumedAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])

  @@unique([userId, quotaType, requestId])
  @@unique([userId, quotaType, sourceId])
  @@index([userId, quotaType, consumedAt])
}

model IdempotencyRecord {
  id                 String            @id
  actorId            String
  operation          String
  idempotencyKey     String
  requestFingerprint String
  status             IdempotencyStatus
  responseStatus     Int?
  responseJson       Json?
  expiresAt          DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  actor              User              @relation(fields: [actorId], references: [id])

  @@unique([actorId, operation, idempotencyKey])
  @@index([expiresAt])
}

model ModerationRecord {
  id                    String             @id
  targetType            String
  targetId              String
  contentVersion        Int
  reviewRound           Int                @default(1)
  priority              ModerationPriority @default(NORMAL)
  priorityRank          Int                @default(1)
  status                String             @default("PENDING")
  hitRuleRefs           Json?
  moderationStatusAfter ModerationStatus?
  publicStatusAfter     PublicStatus?
  handledBy             String?
  handledAt             DateTime?
  reason                String?
  createdAt             DateTime           @default(now())
  handler               User?              @relation(fields: [handledBy], references: [id])

  @@unique([targetType, targetId, contentVersion, reviewRound])
  @@index([status, priorityRank, createdAt, id])
  @@index([targetType, targetId, contentVersion])
}

model Report {
  id               String             @id
  reporterId       String
  targetType       ReportTargetType
  targetId         String
  contentVersion   Int
  reason           ReportReason
  otherDescription String?
  isMinorRelated   Boolean            @default(false)
  priority         ModerationPriority @default(NORMAL)
  priorityRank     Int                @default(1)
  status           ReportStatus       @default(PENDING)
  dedupeKey        String             @unique
  submittedAt      DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  handledBy        String?
  handledAt        DateTime?
  reporter         User               @relation("ReportReporter", fields: [reporterId], references: [id])
  handler          User?              @relation("ReportHandler", fields: [handledBy], references: [id])

  @@index([status, priorityRank, submittedAt, id])
  @@index([reporterId, submittedAt])
  @@index([targetType, targetId, contentVersion])
  @@index([isMinorRelated, priorityRank, status])
}

model AuditLog {
  id             String   @id
  actorId        String
  actorRole      String
  actionType     String
  objectType     String
  objectId       String
  contentVersion Int?
  stateBefore    Json?
  stateAfter     Json?
  reason         String?
  requestId      String
  occurredAt     DateTime @default(now())
  actor          User     @relation(fields: [actorId], references: [id])

  @@index([objectType, objectId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([actionType, occurredAt])
}
